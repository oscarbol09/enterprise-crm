# ==============================================================================
# Enterprise CRM — Environment Template (Copy to .env for local development)
# ==============================================================================

# Environment: development | test | staging | production
ENVIRONMENT=development
PROJECT_NAME="Enterprise CRM Engine"
API_V1_STR="/api/v1"

# PostgreSQL 16+ with pgvector (Use crm_app non-superuser role in production)
DATABASE_URL="postgresql+asyncpg://crm_app:crm_app_dev_pass@localhost:5432/crm_enterprise_db"
# Superuser / Migration URL used by Alembic DDL upgrades
MIGRATION_DATABASE_URL="postgresql+asyncpg://crm_user:crm_secure_pass@localhost:5432/crm_enterprise_db"

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Redis (Distributed rate limiting)
REDIS_URL="redis://localhost:6379/0"
RATE_LIMIT_ENABLED=true

# Security & Cryptography (Generate unique 32+ byte keys for non-dev environments)
# Example AES key generation: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
JWT_SECRET_KEY="dev-only-jwt-secret-key-change-before-staging-or-prod-32bytes"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
APPLICATION_ENCRYPTION_KEY_B64="ZGV2LW9ubHktMzItYnl0ZS1hZXMta2V5LWNoYW5nZSE="
AUTH_COOKIE_SECURE=false

# CORS Origins (JSON list)
ALLOWED_HOSTS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI Providers & Offline Stub Policy (ALLOW_OFFLINE_AI_STUB must be false in production)
DEFAULT_LLM_PROVIDER="gemini"
ALLOW_OFFLINE_AI_STUB=true
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_MODEL="gemini/gemini-3.8-flash"
ANTHROPIC_MODEL="claude-sonnet-4-20250514"
OPENAI_MODEL="gpt-4o"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
